main(){
    String nome = 'João';
    String status = 'aprovado';
    String nota = 9.2;

    String frase1 = nome + " está " + status + " porque tirou nota " + nota.toString()+ "!";
    String frase2 = "$nome está $status porque tirou nota $nota!";//interpolação

    print(frase1);
    print(frase2);

    print("1 + 1 = ${1 + 1}");//ele interpreta dentro das chaves
    //quando quiser usar o $(dolar)como valor literal é só usar a barra na frente \$
}
